# ==========================================
# Stage 1: Build React application
# ==========================================
FROM node:22-alpine AS build

WORKDIR /frontend

COPY frontend/react-app/package*.json ./

RUN npm ci

COPY frontend/react-app/ ./

# Browser-accessible API endpoint.
# This is overridden for AWS production through the build environment.
ARG VITE_API_BASE_URL=http://localhost:8000/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build


# ==========================================
# Stage 2: Serve React with Nginx
# ==========================================
FROM nginx:1.27-alpine

COPY --from=build /frontend/dist /usr/share/nginx/html

COPY frontend/react-app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8501

CMD ["nginx", "-g", "daemon off;"]
