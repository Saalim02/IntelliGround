{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval evaluation dataset",
  "description": "Schema only: populate relevant chunk IDs from human or approved benchmark judgments.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "query_id",
      "language",
      "query",
      "source_document_id",
      "relevant_chunk_ids",
      "evidence",
      "relevance_grade",
      "judgment_status"
    ],
    "properties": {
      "query_id": {"type": "string", "minLength": 1},
      "language": {"type": "string", "minLength": 1},
      "query": {"type": "string", "minLength": 1},
      "source_document_id": {"type": "string", "minLength": 1},
      "relevant_chunk_ids": {
        "type": "array",
        "items": {"type": ["string", "integer"]},
        "uniqueItems": true
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      },
      "relevance_grade": {"type": "number", "minimum": 0},
      "judgment_status": {
        "type": "string",
        "enum": ["UNVERIFIED", "VERIFIED"]
      },
      "relevance_grades": {
        "type": "object",
        "description": "Optional non-negative grade per relevant chunk ID; keys are serialized chunk IDs.",
        "additionalProperties": {"type": "number", "minimum": 0}
      }
    },
    "additionalProperties": false
  }
}
